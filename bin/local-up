#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose --env-file deploy/dev/.env -f docker-compose.dev.yml)
"${compose[@]}" up -d --wait --wait-timeout 300 postgres redis minio gitaly natsmaster temporal casdoor
python bin/pack-runtime.py
"${compose[@]}" build server
"${compose[@]}" run --rm --no-deps server --config=/config/server.docker.toml migration init
"${compose[@]}" run --rm --no-deps server --config=/config/server.docker.toml migration migrate
"${compose[@]}" run --rm --no-deps portal migration init
"${compose[@]}" run --rm --no-deps portal migration migrate
"${compose[@]}" up -d server user dataviewer portal
"${compose[@]}" ps
