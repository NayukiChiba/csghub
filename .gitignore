# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Coverage
coverage/

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.envrc

# DO NOT ignore .env on below folders
!deploy/all_in_one/.env
!deploy/all_in_one_gitea/.env

# tmp
tmp

# local development files
/bin/*
!/bin/*.py
!/bin/*.cjs
!/bin/local-up
!/bin/local-status
/data/
/deploy/dev/*
!/deploy/dev/.env.example
!/deploy/dev/Dockerfile.local
!/deploy/dev/Dockerfile.local.dockerignore
!/deploy/dev/LOCAL.md
!/deploy/dev/README.md
!/deploy/dev/gitaly.config.toml
!/deploy/dev/nats-server.conf
!/deploy/dev/server.local.toml
/docker-compose.dev.yml

# DS_Store
**/.DS_Store

/csghub-portal

.vscode/settings.json

cmd/csghub-portal/__debug_*
app.log

frontend/coverage
coverage.html
junit-report.xml

.idea/
log/
