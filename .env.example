# Keep container and volume names stable when the repository directory changes.
COMPOSE_PROJECT_NAME=csghub

# Browser-facing address. Use the deployment host's LAN IP or domain name.
CSGHUB_EXTERNAL_URL=http://192.168.1.100

# Host directory containing the complete Omnibus persistence tree. Point this
# at an existing deployment to reuse PostgreSQL, MinIO, Git, config, and logs
# without copying them. Never run two containers against the same directory.
CSGHUB_PERSISTENCE_ROOT=./data/omnibus
