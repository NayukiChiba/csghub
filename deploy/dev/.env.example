# Compose 项目名决定容器、网络和数据卷前缀；不同分支请使用不同名称。
COMPOSE_PROJECT_NAME=csghub-dev

# 使用非标准宿主机端口，避免和主分支或本机已有服务冲突。
CSGHUB_DEV_POSTGRES_PORT=15432
CSGHUB_DEV_REDIS_PORT=16379
CSGHUB_DEV_MINIO_API_PORT=19000
CSGHUB_DEV_MINIO_CONSOLE_PORT=19001
CSGHUB_DEV_GITALY_PORT=18075
CSGHUB_DEV_NATS_PORT=14222
CSGHUB_DEV_NATS_MONITOR_PORT=18222
CSGHUB_DEV_TEMPORAL_PORT=17233
CSGHUB_DEV_CASDOOR_PORT=18000
CSGHUB_DEV_TEMPORAL_UI_PORT=18180
