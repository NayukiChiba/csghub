# 通用配置
# 是否为私有化部署。`true` 表示私有化部署，`false` 表示 SaaS 部署。
CSGHUB_PORTAL_ON_PREMISE=true
# 是否启用敏感内容检查。
CSGHUB_PORTAL_SENSITIVE_CHECK=false
# 是否强制站点 URL 使用 HTTPS。
CSGHUB_PORTAL_ENABLE_HTTPS=true
# Portal 服务的监听端口。
CSGHUB_PORTAL_SERVER_PORT=8090
# 超级用户的用户名列表，多个用户名之间使用英文逗号分隔。
CSGHUB_PORTAL_SUPER_USERS=

# csghub-server API 配置
# csghub-server 服务的 URL。
# https://github.com/OpenCSGs/csghub-server
CSGHUB_PORTAL_STARHUB_BASE_URL=http://localhost:8080
# 用于访问 csghub-server API 的密钥。
CSGHUB_PORTAL_STARHUB_API_KEY=f3a7b9c1d6e5f8e2a1b5d4f9e6a2b8d7c3a4e2b1d9f6e7a8d2c5a7b4c1e3f5b8a1d4f9b7d6e2f8a5d3b1e7f9c6a8b2d1e4f7d5b6e9f2a4b3c8e1d7f995hd82hf

# 数据库配置
# 数据库连接的数据源名称（DSN）。
CSGHUB_PORTAL_DATABASE_DSN=postgresql://postgres:postgres@localhost:5432/csghub_development?sslmode=disable
# 数据库类型。可选值为 `pg`（PostgreSQL）或 `sqlite`。
CSGHUB_PORTAL_DATABASE_DIALECT=pg

# 身份认证配置
# 外部身份认证提供方的注册页面 URL。
CSGHUB_PORTAL_SIGNUP_URL=
# 外部身份认证提供方的登录页面 URL。
CSGHUB_PORTAL_LOGIN_URL=

# 公共 S3 存储配置
# S3 服务的访问端点。
CSGHUB_PORTAL_S3_ENDPOINT=
# S3 访问端点是否使用 SSL。
CSGHUB_PORTAL_S3_ENABLE_SSL=true
# S3 存储桶所在的区域。
CSGHUB_PORTAL_S3_REGION=
# S3 访问密钥 ID。
CSGHUB_PORTAL_S3_ACCESS_KEY_ID=
# S3 访问密钥 Secret。
CSGHUB_PORTAL_S3_ACCESS_KEY_SECRET=
# 用于存储公共文件的 S3 存储桶名称。
CSGHUB_PORTAL_S3_BUCKET=

# 私有 S3 存储配置
# 私有 S3 服务的访问端点。
CSGHUB_PORTAL_PRIVATE_S3_ENDPOINT=
# 私有 S3 访问端点是否使用 SSL。
CSGHUB_PORTAL_PRIVATE_S3_ENABLE_SSL=false
# 私有 S3 存储桶所在的区域。
CSGHUB_PORTAL_PRIVATE_S3_REGION=
# 私有 S3 的访问密钥 ID。
CSGHUB_PORTAL_PRIVATE_S3_ACCESS_KEY_ID=
# 私有 S3 的访问密钥 Secret。
CSGHUB_PORTAL_PRIVATE_S3_ACCESS_KEY_SECRET=
# 用于存储私有文件的 S3 存储桶名称。
CSGHUB_PORTAL_PRIVATE_S3_BUCKET=
